{
  "name": "@tsc/pob-codec",
  "version": "0.1.0",
  "description": "Encode and decode Path of Building build codes (base64 + zlib)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "path-of-exile",
    "pob",
    "path-of-building",
    "codec",
    "build-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/twilight-strand-collective/build",
    "directory": "packages/pob-codec"
  },
  "dependencies": {
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/pako": "^2.0.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
