{
  "name": "@tsc/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-worker.mjs && next dev --turbopack",
    "dev:worker": "node scripts/build-worker.mjs --watch",
    "build": "node scripts/build-worker.mjs --minify && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@neondatabase/serverless": "^0.10.4",
    "@tsc/pob-codec": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "next": "^15.3.0",
    "next-auth": "5.0.0-beta.25",
    "pako": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wasmoon": "1.16.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "drizzle-kit": "^0.28.1",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
