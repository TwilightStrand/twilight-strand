{
  "name": "twilight-strand-collective",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "cd apps/web && npx tsc --noEmit",
    "test": "turbo test",
    "data:fetch": "cd packages/pob-data && bash fetch-pob.sh && bash fetch-tree.sh && bash gen-manifest.sh",
    "data:gen": "node apps/web/scripts/convert-tree-lua.mjs && node apps/web/scripts/gen-cluster-data.mjs && node apps/web/scripts/gen-gem-data.mjs && node apps/web/scripts/gen-unique-data.mjs",
    "data:all": "pnpm data:fetch && pnpm data:gen",
    "engine:test": "cd packages/engine && cargo test",
    "engine:build": "cd packages/engine && bash build.sh",
    "worker:build": "node apps/web/scripts/build-worker.mjs",
    "test:e2e": "node apps/web/scripts/e2e-test.mjs",
    "test:all": "pnpm test && pnpm engine:test"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.36.4",
    "next-auth": "5.0.0-beta.32"
  }
}