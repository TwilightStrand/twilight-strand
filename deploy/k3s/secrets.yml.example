# Copy to secrets.yml and fill in values. DO NOT commit secrets.yml.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: twilight-strand
type: Opaque
stringData:
  POSTGRES_USER: tsc
  POSTGRES_PASSWORD: CHANGE_ME
  POSTGRES_DB: tsc
---
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: twilight-strand
type: Opaque
stringData:
  DATABASE_URL: postgresql://tsc:CHANGE_ME@postgres:5432/tsc
  AUTH_SECRET: GENERATE_WITH_openssl_rand_-base64_32
  GITHUB_CLIENT_ID: ""
  GITHUB_CLIENT_SECRET: ""
  DISCORD_CLIENT_ID: ""
  DISCORD_CLIENT_SECRET: ""
